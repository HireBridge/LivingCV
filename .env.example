# ─────────────────────────────────────────────────────────────────────────────
# Bootstrap environment. The easiest path is `./scripts/start.sh`, which fills
# this in for you (asks for a domain, auto-generates every secret). You only
# need to touch this file if you prefer to configure by hand.
# Everything else is configured post-boot in the admin UI (/admin/setup).
# ─────────────────────────────────────────────────────────────────────────────

# Public domain the site is served on (no protocol). Leave blank to run locally
# on http://localhost. Set to your domain (e.g. example.com) for a public deploy.
DOMAIN=

# Caddy site address, derived from DOMAIN by scripts/start.sh:
#   - a bare domain (example.com) → Caddy gets an automatic Let's Encrypt cert
#     and serves HTTPS (needs ports 80/443 open + DNS pointed at the box).
#   - ":80" (the default) → plain HTTP, for local testing with no domain.
# If you edit .env by hand, set this to your domain for HTTPS.
SITE_ADDRESS=:80

# Directory holding portfolio.db and uploaded files (resume PDF). In docker this
# is the `portfolio-data` volume mount (default /data). Local dev defaults to
# ./data. Both the web and orchestrator processes open the same portfolio.db
# file inside it (SQLite WAL + busy_timeout).
DATA_DIR=./data

# 32-byte base64 key used to encrypt secrets stored in app_settings
# (AES-256-GCM). Generate with:  openssl rand -base64 32
# The setup wizard can also generate one if missing. LOSE THIS KEY = every
# encrypted value in app_settings becomes unrecoverable. Back it up.
PORTFOLIO_ENCRYPTION_KEY=

# Secret used to seal admin sessions (iron-session). Generate with:
# openssl rand -base64 32
SESSION_SECRET=

# Bearer token for jobops's authenticated /mcp endpoint (admin features).
# jobops generates this on `jobops init`. The public /mcp/public mount is open.
JOBOPS_AUTH_TOKEN=

# Salt mixed into the sha256 hash of visitor IPs (per-IP rate limiting + session
# accounting). Any random string. Lets you bucket sessions by IP without
# storing the IP itself.
IP_HASH_SALT=

# ─── Ports (defaults match docker-compose.yml; override for local dev) ───
WEB_PORT=3000
ORCHESTRATOR_PORT=8100
JOBOPS_PORT=7891
