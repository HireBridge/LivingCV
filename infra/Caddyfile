# Caddy is the public-facing reverse proxy. Automatic HTTPS for {$DOMAIN}.
#
# Routes: /api/orchestrator/api/chat/* → orchestrator (the only orchestrator
#         surface exposed publicly; /internal/* and /api/mcp/* are not).
#         /mcp-admin/* → orchestrator master relay MCP (operator key required).
#         /mcp/* → jobops. Two mounts are exposed there:
#                  - /mcp/public  -> open, lists exactly 2 public tools
#                                     (the only thing the portfolio advertises)
#                  - /mcp         -> bearer-gated, all 51 tools (operator-only)
#                                     The public internet sees /mcp/public;
#                                     the admin / dashboard hits /mcp with
#                                     a bearer from inside the docker network.
# External clients should be configured to use the canonical public URL
# `{site.domain}/mcp/public` — see docs/PUBLIC_MCP.md.
#
# Site address comes from $SITE_ADDRESS (set by scripts/start.sh from DOMAIN):
#   - a bare domain (e.g. example.com) → Caddy gets an automatic Let's Encrypt
#     cert and serves HTTPS (needs ports 80/443 open + DNS pointed at the box).
#   - the default ":80" → plain HTTP, for local testing with no domain.

{$SITE_ADDRESS::80} {
  encode zstd gzip

  # Defense-in-depth security headers. Caddy already applies HSTS via its
  # automatic-HTTPS path; the explicit header set below is a safety net.
  header {
    # Don't let browsers / iframes interpret the response as something else.
    X-Content-Type-Options "nosniff"
    X-Frame-Options        "DENY"
    Referrer-Policy        "no-referrer-when-downgrade"
    Permissions-Policy     "geolocation=(), microphone=(self), camera=(), payment=()"
    # Defence against MIME-sniffing and click-jacking; set CSP conservatively
    # to "self only" — the classic template loads its own fonts, styles, and
    # images from the same origin.
    Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self' ws: wss:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com; frame-ancestors 'none'"
    # HSTS omitted on local dev (no TLS)
    Server ""   # Strip the Caddy server header (no version disclosure).
  }


  handle /api/orchestrator/api/chat/* {
    uri strip_prefix /api/orchestrator
    reverse_proxy orchestrator:8100
  }

  handle_path /mcp-admin/* {
    rewrite * /api/mcp{path}
    reverse_proxy orchestrator:8100
  }

  # Public MCP: gated by the admin "Public MCP" toggle. Caddy asks the web app
  # (forward_auth) whether it's enabled; a 2xx lets the request reach jobops,
  # a 403 blocks it. The recruiter concierge reaches jobops internally and is
  # unaffected. More specific than /mcp* so it matches /mcp/public first.
  handle /mcp/public* {
    forward_auth web:3000 {
      uri /api/public-mcp-gate
    }
    reverse_proxy jobops:7891
  }

  handle /mcp* {
    reverse_proxy jobops:7891
  }

  handle {
    reverse_proxy web:3000
  }
}
