# Caddy is the public-facing reverse proxy. Automatic HTTPS for {$DOMAIN}.
#
# Phase 2 routes: /api/orchestrator/chat/* → orchestrator.
# Phase 3 routes: /voice-ws → voice service (websocket upgrade).
# Phase 4 routes: /mcp/* → jobops. Two mounts are exposed there:
#                  - /mcp/public  -> open, lists exactly 2 public tools
#                                     (the only thing the portfolio advertises)
#                  - /mcp         -> bearer-gated, all 51 tools (operator-only)
#                                     The public internet sees /mcp/public;
#                                     the admin / dashboard hits /mcp with
#                                     a bearer from inside the docker network.
# External clients should be configured to use the canonical public URL
# `{site.domain}/mcp/public` — see docs/PUBLIC_MCP.md.

{$DOMAIN} {
  encode zstd gzip

  # Defense-in-depth security headers. Caddy already applies HSTS via its
  # automatic-HTTPS path; the explicit header set below is a safety net.
  header {
    # Don't let browsers / iframes interpret the response as something else.
    X-Content-Type-Options "nosniff"
    X-Frame-Options        "DENY"
    Referrer-Policy        "no-referrer-when-downgrade"
    Permissions-Policy     "geolocation=(), microphone=(self), camera=(), payment=()"
    # Defence against MIME-sniffing and click-jacking; set CSP conservatively
    # to "self only" — the classic template loads its own fonts, styles, and
    # images from the same origin.
    Content-Security-Policy "default-src 'self'; img-src 'self' data:; \
                              style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; \
                              font-src 'self' https://fonts.gstatic.com; \
                              script-src 'self' 'unsafe-inline'; \
                              connect-src 'self' ws: wss:; \
                              frame-ancestors 'none'"
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Server ""   # Strip the Caddy server header (no version disclosure).
  }

  reverse_proxy web:3000

  handle /voice-ws* {
    reverse_proxy voice:8200
  }

  handle /api/orchestrator/* {
    reverse_proxy orchestrator:8100
  }

  handle /mcp* {
    reverse_proxy jobops:7891
  }
}
