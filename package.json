{
  "name": "portfolio-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "ci": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "eslint": "^9.10.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
